{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "How this rule appears when configuring it."
    },
    "negate": {
      "type": "boolean",
      "description": "If true, the rule will fail if the pattern matches."
    },
    "operator": {
      "type": "string",
      "description": "The operator to use for matching.",
      "enum": [
        "starts_with",
        "ends_with",
        "contains",
        "regex"
      ]
    },
    "pattern": {
      "type": "string",
      "description": "The pattern to match with."
    }
  },
  "required": [
    "operator",
    "pattern"
  ]
}
