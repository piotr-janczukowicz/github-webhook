          "type": [
            "integer",
            "null"
          ]
        },
        "runner_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "status": {
          "description": "The current status of the job. Can be `queued`, `in_progress`, `waiting`, or `completed`.",
          "type": "string",
          "enum": [
            "queued",
            "in_progress",
            "completed",
            "waiting"
          ]
        },
