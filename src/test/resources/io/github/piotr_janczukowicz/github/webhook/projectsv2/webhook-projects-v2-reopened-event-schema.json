      "properties": {
        "login": {
          "type": "string",
          "examples": [
            "github"
          ]
        },
        "id": {
          "type": "integer",
          "examples": [
            1
          ]
        },
        "node_id": {
          "type": "string",
          "examples": [
            "MDEyOk9yZ2FuaXphdGlvbjE="
