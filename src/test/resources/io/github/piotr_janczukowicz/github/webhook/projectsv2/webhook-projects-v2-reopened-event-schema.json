          ]
        },
        "public_members_url": {
          "type": "string",
          "examples": [
            "https://api.github.com/orgs/github/public_members{/member}"
          ]
        },
        "avatar_url": {
          "type": "string",
          "examples": [
            "https://github.com/images/error/octocat_happy.gif"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "A great organization"
          ]
        }
